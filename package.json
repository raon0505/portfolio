{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "lint:css": "stylelint \"**/*.css\" --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm lint:css && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@next/third-parties": "16.4.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.5.3"
}
